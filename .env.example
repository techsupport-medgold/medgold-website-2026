# Public site origin, no trailing slash. Drives canonical URLs, sitemap, robots, OG, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://medgold.com

# Optional override for the launch countdown (default: 2026-11-08T00:00:00+05:30 in src/config/site.ts).
NEXT_PUBLIC_LAUNCH_DATE=

# Search console verification tokens (leave blank to omit the meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google Tag Manager (only injected when set).
NEXT_PUBLIC_GTM_ID=

# Optional override for the Microsoft Clarity project ID (default in src/config/site.ts).
# Clarity loads on the production site only, never on localhost or Vercel previews.
NEXT_PUBLIC_CLARITY_ID=
