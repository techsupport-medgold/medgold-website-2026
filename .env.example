# Public site origin, no trailing slash. Drives canonical URLs, sitemap, robots, OG, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://medgoldhealthcare.com

# Search console verification tokens (leave blank to omit the meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional override for the Google Tag Manager container ID (default in src/config/site.ts).
NEXT_PUBLIC_GTM_ID=

# Email for the careers and contact forms (Gmail or Google Workspace SMTP with an App Password).
# See "Form emails" in README.md. Server-only: never prefix these with NEXT_PUBLIC_.
SMTP_USER=sundharmedgold@gmail.com
SMTP_APP_PASSWORD=
# Inbox that receives applications and enquiries (comma-separate for several).
MAIL_TO=sundharmedgold@gmail.com

# Optional override for the Microsoft Clarity project ID (default in src/config/site.ts).
# Clarity loads on the production site only, never on localhost or Vercel previews.
NEXT_PUBLIC_CLARITY_ID=
